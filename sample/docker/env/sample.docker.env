# sample.docker.env — DOCKER-INFRASTRUCTURE config (compose interpolation,
# build args, resource limits). Never loaded into any container environment.
# Copy to <instance>.docker.env.

#images
IMAGE_TAG=latest
IMAGE_REPO=manager/app
IMAGE_REPO_NGINX=manager/app-nginx

#ports (host → nginx; unique per instance)
HTTP_PORT=8080
WS_PORT=8081
#host address the ports bind to; empty = all interfaces. 127.0.0.1 behind a
#host reverse proxy — Docker-published ports bypass host firewall rules.
PUBLISH_IP=

#runtime identity for php/ws/cron/cli — no rebuild, takes effect on recreate.
#Numeric (1001) or a name present in the image. Bind-mount sources
#(MEDIA_PATH, PRIVATE_PATH) must already be owned by it on the host.
#APP_USER=www-data
#APP_GROUP=www-data

#healthcheck interval for every service (startup probes run every 5s
#regardless, so this doesn't slow `up`); takes effect on recreate
HEALTHCHECK_INTERVAL=30s

#resources — every *_MEM_LIMIT is a hard cap (swap included); a service
#that reaches it is OOM-killed. Engine knobs below must fit inside their cap.
#optional parent cgroup for every container of every instance (fleet cap)
CGROUP_PARENT=
PHP_PM_MAX_CHILDREN=20
#dynamic | ondemand (frees idle workers; build arg like the line above)
PHP_PM_MODE=dynamic
PHP_MEM_LIMIT=1024m
PHP_CPUS=2.0
NGINX_MEM_LIMIT=128m
NGINX_CPUS=1.0
NGINX_NOFILE=8192
WS_MEM_LIMIT=256m
WS_CPUS=1.0
CRON_MEM_LIMIT=256m
CRON_CPUS=0.5
CLI_MEM_LIMIT=512m
CLI_CPUS=1.0
VALKEY_STATE_MEM_LIMIT=320m
VALKEY_STATE_CPUS=0.5
VALKEY_CACHE_MEM_LIMIT=256m
VALKEY_CACHE_CPUS=0.5
#VALKEY_STATE_MEM_LIMIT ≥ 2 × VALKEY_STATE_MAXMEMORY + 64m — its AOF-rewrite
#fork can copy the whole dataset; bin/valkey-profile.sh verifies a pairing
VALKEY_STATE_MAXMEMORY=128mb
VALKEY_CACHE_MAXMEMORY=128mb
TOOLS_MEM_LIMIT=2048m
TOOLS_CPUS=2.0

#bundled db profiles — MAX_CONNECTIONS ≥ PHP_PM_MAX_CHILDREN + ws +
#cron + CLI/async jobs + a few admin sessions
MYSQL_MEM_LIMIT=512m
MYSQL_CPUS=1.0
MYSQL_INNODB_BUFFER_POOL_SIZE=128M
MYSQL_MAX_CONNECTIONS=30
MYSQL_TEMPTABLE_MAX_RAM=64M
MYSQL_PERFORMANCE_SCHEMA=OFF
MARIADB_MEM_LIMIT=640m
MARIADB_CPUS=1.0
MARIADB_INNODB_BUFFER_POOL_SIZE=128M
MARIADB_MAX_CONNECTIONS=30
#per session — MAX_CONNECTIONS × this must fit in the cap too
MARIADB_TMP_TABLE_SIZE=4M
POSTGRES_MEM_LIMIT=640m
POSTGRES_CPUS=1.0
POSTGRES_SHARED_BUFFERS=128MB
POSTGRES_EFFECTIVE_CACHE_SIZE=256MB
#per sort/hash node per process
POSTGRES_WORK_MEM=4MB
POSTGRES_MAINTENANCE_WORK_MEM=64MB
POSTGRES_MAX_CONNECTIONS=30
POSTGRES_MAX_PARALLEL_WORKERS_PER_GATHER=0
POSTGRES_SHM_SIZE=128m

#host bind-mount sources (relative to docker/, or absolute)
MEDIA_PATH=../public/media
PRIVATE_PATH=../private
#empty = named volumes, which down -v deletes; on a server, bind paths
#that include the instance name: ./data/<instance>/postgres, …/valkey-state
POSTGRES_DATA=
VALKEY_STATE_DATA=

#entrypoint toggles
WAIT_FOR_DB=true
RUN_MIGRATIONS=false

#smoke-test module (build local images only)
INCLUDE_SMOKE_MODULE=false

#tools bind path
TOOLS_BIND_PATH=..

#application live-code bind mode (relative to docker/, or absolute)
#only used with (-b) mode
#host path containing application/ to bind-mount over the
#baked image code.
#CODE_BIND_PATH=..

#framework live-code bind mode (relative to docker/, or absolute)
#only used with (-m) mode
#host path containing system/ to bind-mount over
#vendor/ixaya/manager/system in the baked image.
#MANAGER_BIND_PATH=